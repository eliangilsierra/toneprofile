# "mock" runs the whole product against the in-browser demo backend (MSW, fictional data).
# "http" proxies /api/v1/* to the real backend below.
NEXT_PUBLIC_API_MODE=mock

# Backend base URL (used only when NEXT_PUBLIC_API_MODE=http). Server-side only.
TONEPROFILE_API_URL=http://localhost:8000

# Absolute site URL for metadata (Open Graph, canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
